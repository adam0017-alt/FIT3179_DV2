{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 520,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/sa3_2021.topojson",
        "format": {
          "type": "topojson",
          "feature": "sa3_2021"
        }
      },
      "transform": [
        {
          "lookup": "properties.sa3_code",
          "from": {
            "data": {
              "url": "data/sa3_metrics.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "sa3_code": "string",
                  "lon": "number",
                  "lat": "number",
                  "bowel_rate": "number",
                  "bowel_rate_1819": "number",
                  "bowel_invited": "number",
                  "bowel_participated": "number",
                  "breast_rate": "number",
                  "cervical_rate": "number",
                  "irsd": "number",
                  "irsd_quintile": "number",
                  "population": "number",
                  "bowel_change": "number",
                  "bowel_unscreened": "number",
                  "x_adv": "number",
                  "y_rate": "number"
                }
              }
            },
            "key": "sa3_code",
            "fields": [
              "sa3_name",
              "state",
              "bivar",
              "bowel_rate",
              "irsd_quintile"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.3
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.bivar && datum.bivar!=''",
            "field": "bivar",
            "type": "nominal",
            "scale": {
              "domain": [
                "1-1",
                "2-1",
                "3-1",
                "1-2",
                "2-2",
                "3-2",
                "1-3",
                "2-3",
                "3-3"
              ],
              "range": [
                "#b9b9b9",
                "#ace4e4",
                "#5ac8c8",
                "#dfb0d6",
                "#a5add3",
                "#5698b9",
                "#be64ac",
                "#8c62aa",
                "#3b4994"
              ]
            },
            "legend": null
          },
          "value": "#f1ece1"
        },
        "tooltip": [
          {
            "field": "sa3_name",
            "title": "Area"
          },
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "bowel_rate",
            "title": "Bowel screening (%)",
            "format": ".1f"
          },
          {
            "field": "irsd_quintile",
            "title": "Disadvantage fifth (1 = most)"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/states_2021.topojson",
        "format": {
          "type": "topojson",
          "feature": "states_2021"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#6b665e",
        "strokeWidth": 0.8
      }
    }
  ],
  "config": {
    "background": null,
    "font": "Helvetica Neue, Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "titleFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "labelColor": "#6b665e",
      "titleColor": "#6b665e",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "gridColor": "#e7e1d6",
      "domainColor": "#b8b0a2",
      "tickColor": "#b8b0a2"
    },
    "legend": {
      "labelFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "titleFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "labelColor": "#6b665e",
      "titleColor": "#6b665e",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal"
    },
    "header": {
      "labelFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "titleFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "labelColor": "#2b2a28",
      "labelFontSize": 13,
      "labelFontWeight": "bold"
    },
    "title": {
      "font": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "color": "#2b2a28"
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}