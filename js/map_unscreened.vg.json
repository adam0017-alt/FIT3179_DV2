{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 520,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/sa3_2021.topojson",
        "format": {
          "type": "topojson",
          "feature": "sa3_2021"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e3ded4",
        "stroke": "white",
        "strokeWidth": 0.3
      }
    },
    {
      "data": {
        "url": "data/states_2021.topojson",
        "format": {
          "type": "topojson",
          "feature": "states_2021"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#6b665e",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/sa3_metrics.csv",
        "format": {
          "type": "csv",
          "parse": {
            "sa3_code": "string",
            "lon": "number",
            "lat": "number",
            "bowel_rate": "number",
            "bowel_rate_1819": "number",
            "bowel_invited": "number",
            "bowel_participated": "number",
            "breast_rate": "number",
            "cervical_rate": "number",
            "irsd": "number",
            "irsd_quintile": "number",
            "population": "number",
            "bowel_change": "number",
            "bowel_unscreened": "number",
            "x_adv": "number",
            "y_rate": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "isValid(datum.bowel_unscreened) && isValid(datum.lon)"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#b4551d",
        "opacity": 0.62,
        "stroke": "white",
        "strokeWidth": 0.6
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "bowel_unscreened",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "range": [
              8,
              1900
            ]
          },
          "legend": {
            "title": "Invited but not screened",
            "orient": "bottom-left",
            "offset": -4,
            "format": ",.0f",
            "values": [
              5000,
              15000,
              30000
            ]
          }
        },
        "tooltip": [
          {
            "field": "sa3_name",
            "title": "Area"
          },
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "bowel_invited",
            "title": "People invited",
            "format": ","
          },
          {
            "field": "bowel_unscreened",
            "title": "Not screened",
            "format": ","
          },
          {
            "field": "bowel_rate",
            "title": "Participation (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/sa3_metrics.csv",
        "format": {
          "type": "csv",
          "parse": {
            "sa3_code": "string",
            "lon": "number",
            "lat": "number",
            "bowel_rate": "number",
            "bowel_rate_1819": "number",
            "bowel_invited": "number",
            "bowel_participated": "number",
            "breast_rate": "number",
            "cervical_rate": "number",
            "irsd": "number",
            "irsd_quintile": "number",
            "population": "number",
            "bowel_change": "number",
            "bowel_unscreened": "number",
            "x_adv": "number",
            "y_rate": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.bowel_unscreened > 33500"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -16,
        "fontSize": 12,
        "fontWeight": "bold",
        "fill": "#faf6ef",
        "stroke": "#faf6ef",
        "strokeWidth": 4
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "sa3_name"
        }
      }
    },
    {
      "data": {
        "url": "data/sa3_metrics.csv",
        "format": {
          "type": "csv",
          "parse": {
            "sa3_code": "string",
            "lon": "number",
            "lat": "number",
            "bowel_rate": "number",
            "bowel_rate_1819": "number",
            "bowel_invited": "number",
            "bowel_participated": "number",
            "breast_rate": "number",
            "cervical_rate": "number",
            "irsd": "number",
            "irsd_quintile": "number",
            "population": "number",
            "bowel_change": "number",
            "bowel_unscreened": "number",
            "x_adv": "number",
            "y_rate": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.bowel_unscreened > 33500"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -16,
        "fontSize": 12,
        "fontWeight": "bold",
        "fill": "#2b2a28"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "sa3_name"
        }
      }
    }
  ],
  "config": {
    "background": null,
    "font": "Helvetica Neue, Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "titleFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "labelColor": "#6b665e",
      "titleColor": "#6b665e",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "gridColor": "#e7e1d6",
      "domainColor": "#b8b0a2",
      "tickColor": "#b8b0a2"
    },
    "legend": {
      "labelFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "titleFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "labelColor": "#6b665e",
      "titleColor": "#6b665e",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal"
    },
    "header": {
      "labelFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "titleFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "labelColor": "#2b2a28",
      "labelFontSize": 13,
      "labelFontWeight": "bold"
    },
    "title": {
      "font": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "color": "#2b2a28"
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}