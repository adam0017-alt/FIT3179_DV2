{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "padding": {
    "left": 60,
    "right": 20,
    "top": 5,
    "bottom": 5
  },
  "data": {
    "url": "data/bowel_extremes.csv",
    "format": {
      "type": "csv",
      "parse": {
        "bowel_rate": "number"
      }
    }
  },
  "width": "container",
  "height": 330,
  "encoding": {
    "y": {
      "field": "sa3_name",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "axis": {
        "labelLimit": 260
      }
    },
    "x": {
      "field": "bowel_rate",
      "type": "quantitative",
      "title": "Share of invited people who returned a kit (%)",
      "scale": {
        "domain": [
          0,
          60
        ]
      },
      "axis": {
        "tickCount": 6
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2
      },
      "encoding": {
        "x2": {
          "datum": 0
        },
        "color": {
          "field": "grp",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Lowest",
              "Highest"
            ],
            "range": [
              "#4a4e69",
              "#d9a400"
            ]
          }
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 110,
        "opacity": 1
      },
      "encoding": {
        "color": {
          "field": "grp",
          "type": "nominal",
          "legend": {
            "title": null,
            "orient": "bottom-right"
          },
          "scale": {
            "domain": [
              "Lowest",
              "Highest"
            ],
            "range": [
              "#4a4e69",
              "#d9a400"
            ]
          }
        },
        "tooltip": [
          {
            "field": "sa3_name",
            "title": "Area"
          },
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "bowel_rate",
            "title": "Screened (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 9,
        "fontSize": 11,
        "fill": "#2b2a28"
      },
      "encoding": {
        "text": {
          "field": "bowel_rate",
          "format": ".1f"
        }
      }
    }
  ],
  "config": {
    "background": null,
    "font": "Helvetica Neue, Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "titleFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "labelColor": "#6b665e",
      "titleColor": "#6b665e",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "gridColor": "#e7e1d6",
      "domainColor": "#b8b0a2",
      "tickColor": "#b8b0a2"
    },
    "legend": {
      "labelFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "titleFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "labelColor": "#6b665e",
      "titleColor": "#6b665e",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal"
    },
    "header": {
      "labelFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "titleFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "labelColor": "#2b2a28",
      "labelFontSize": 13,
      "labelFontWeight": "bold"
    },
    "title": {
      "font": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "color": "#2b2a28"
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}