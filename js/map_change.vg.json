{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 520,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/sa3_2021.topojson",
        "format": {
          "type": "topojson",
          "feature": "sa3_2021"
        }
      },
      "transform": [
        {
          "lookup": "properties.sa3_code",
          "from": {
            "data": {
              "url": "data/sa3_metrics.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "sa3_code": "string",
                  "lon": "number",
                  "lat": "number",
                  "bowel_rate": "number",
                  "bowel_rate_1819": "number",
                  "bowel_invited": "number",
                  "bowel_participated": "number",
                  "breast_rate": "number",
                  "cervical_rate": "number",
                  "irsd": "number",
                  "irsd_quintile": "number",
                  "population": "number",
                  "bowel_change": "number",
                  "bowel_unscreened": "number",
                  "x_adv": "number",
                  "y_rate": "number"
                }
              }
            },
            "key": "sa3_code",
            "fields": [
              "sa3_name",
              "state",
              "bowel_change",
              "bowel_rate_1819",
              "bowel_rate"
            ]
          }
        },
        {
          "calculate": "!isValid(datum.bowel_change) ? 'No figure' : datum.bowel_change < -5 ? 'Fell by 5+ points' : datum.bowel_change < -3 ? 'Fell 3 to 5' : datum.bowel_change < -1 ? 'Fell 1 to 3' : datum.bowel_change < 1 ? 'About the same (within 1)' : 'Rose by 1+'",
          "as": "cls"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.3
      },
      "encoding": {
        "color": {
          "field": "cls",
          "type": "ordinal",
          "scale": {
            "domain": [
              "Fell by 5+ points",
              "Fell 3 to 5",
              "Fell 1 to 3",
              "About the same (within 1)",
              "Rose by 1+",
              "No figure"
            ],
            "range": [
              "#a8322d",
              "#e8845f",
              "#f6cdb6",
              "#eee9df",
              "#5b9fc7",
              "#e3ded4"
            ]
          },
          "legend": {
            "title": "Change in participation",
            "orient": "bottom-left",
            "offset": -4,
            "symbolType": "square",
            "symbolSize": 180,
            "symbolStrokeWidth": 0
          }
        },
        "tooltip": [
          {
            "field": "sa3_name",
            "title": "Area"
          },
          {
            "field": "bowel_rate_1819",
            "title": "2018\u201319 (%)",
            "format": ".1f"
          },
          {
            "field": "bowel_rate",
            "title": "2023\u201324 (%)",
            "format": ".1f"
          },
          {
            "field": "bowel_change",
            "title": "Change (points)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/states_2021.topojson",
        "format": {
          "type": "topojson",
          "feature": "states_2021"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#6b665e",
        "strokeWidth": 0.8
      }
    }
  ],
  "config": {
    "background": null,
    "font": "Helvetica Neue, Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "titleFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "labelColor": "#6b665e",
      "titleColor": "#6b665e",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "gridColor": "#e7e1d6",
      "domainColor": "#b8b0a2",
      "tickColor": "#b8b0a2"
    },
    "legend": {
      "labelFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "titleFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "labelColor": "#6b665e",
      "titleColor": "#6b665e",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal"
    },
    "header": {
      "labelFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "titleFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "labelColor": "#2b2a28",
      "labelFontSize": 13,
      "labelFontWeight": "bold"
    },
    "title": {
      "font": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "color": "#2b2a28"
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}