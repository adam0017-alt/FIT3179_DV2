{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/waffle.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "datum.program + (datum.screened==1 ? ' yes' : ' no')",
      "as": "key"
    }
  ],
  "facet": {
    "column": {
      "field": "label",
      "type": "nominal",
      "title": null,
      "header": {
        "labelExpr": "split(datum.label,'|')",
        "labelOrient": "top",
        "labelLineHeight": 16,
        "labelPadding": 8,
        "labelFontWeight": "normal"
      }
    }
  },
  "spec": {
    "width": 170,
    "height": 170,
    "mark": {
      "type": "rect",
      "stroke": "#faf6ef",
      "strokeWidth": 2,
      "cornerRadius": 2
    },
    "encoding": {
      "x": {
        "field": "col",
        "type": "ordinal",
        "axis": null
      },
      "y": {
        "field": "row",
        "type": "ordinal",
        "sort": "descending",
        "axis": null
      },
      "color": {
        "field": "key",
        "type": "nominal",
        "legend": null,
        "scale": {
          "domain": [
            "Bowel yes",
            "Bowel no",
            "Breast yes",
            "Breast no",
            "Cervical yes",
            "Cervical no"
          ],
          "range": [
            "#b4551d",
            "#e6dfd3",
            "#c23b78",
            "#e6dfd3",
            "#1f8a7e",
            "#e6dfd3"
          ]
        }
      },
      "tooltip": [
        {
          "field": "program",
          "title": "Program"
        },
        {
          "field": "rate",
          "title": "Participation rate (%)"
        },
        {
          "field": "period",
          "title": "Period"
        }
      ]
    }
  },
  "resolve": {
    "scale": {
      "color": "shared"
    }
  },
  "config": {
    "background": null,
    "font": "Helvetica Neue, Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "titleFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "labelColor": "#6b665e",
      "titleColor": "#6b665e",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "gridColor": "#e7e1d6",
      "domainColor": "#b8b0a2",
      "tickColor": "#b8b0a2"
    },
    "legend": {
      "labelFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "titleFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "labelColor": "#6b665e",
      "titleColor": "#6b665e",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal"
    },
    "header": {
      "labelFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "titleFont": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "labelColor": "#2b2a28",
      "labelFontSize": 13,
      "labelFontWeight": "bold"
    },
    "title": {
      "font": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "color": "#2b2a28"
    }
  }
}